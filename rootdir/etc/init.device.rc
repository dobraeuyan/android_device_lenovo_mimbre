on boot
    chown system system /sys/class/leds/white-notification/brightness
    chown system system /sys/class/leds/white-notification/blink
    chmod 0664 /sys/class/leds/white-notification/brightness
    chmod 0664 /sys/class/leds/white-notification/blink

on charger
    chown system system /sys/class/leds/white-notification/brightness
    chown system system /sys/class/leds/white-notification/blink
    chmod 0664 /sys/class/leds/white-notification/brightness
    chmod 0664 /sys/class/leds/white-notification/blink
    start vendor.charger_led

on post-fs
    symlink /mnt/vendor/fwmt /firmware

    start vendor.qseecomd

    start vendor.qsee-kmload

service vendor.sensors-hal-1-0 /vendor/bin/hw/android.hardware.sensors@1.0-service
    class hal
    user system
    group system wakelock uhid input
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
    override

service vendor.charger_led /vendor/bin/charger_led
    class charger
    user system
    group system
    disabled

on property:init.svc.bootanim=stopped
    write /sys/class/leds/white-notification/brightness 0
