on post-fs
    write /sys/module/firmware_class/parameters/path /mnt/fwmt/image

    symlink /mnt/fwmt /firmware

    start vendor.qseecomd

    start vendor.qsee-kmload

service vendor.sensors-hal-1-0 /vendor/bin/hw/android.hardware.sensors@1.0-service
    class hal
    user system
    group system wakelock uhid input
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
    override
